# .clang-format — code formatting for C++/CUDA.
#
# TECH_STACK names clang-format. Based on the Google C++ style (a clean,
# widely-recognized default) with a 100-column limit and explicit CUDA handling.
# Run: clang-format -i <files>  (or the format target / pre-commit later).

BasedOnStyle: Google
Language: Cpp
Standard: c++17
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -1
PointerAlignment: Left
DerivePointerAlignment: false
SortIncludes: true
IncludeBlocks: Preserve
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse

# Treat CUDA sources/headers as C++ so .cu/.cuh format consistently.
---
Language: Cpp
